//AUDINT01 JOB (ACCT),'REQ4-SUCCESS',CLASS=A,MSGCLASS=X
//*===================================================================*
//* REQUIREMENT 4 — SUCCESS TEST CASE                                 *
//* 1. IBM SORT: COPY & SORT INPUT IN DESCENDING ORDER                *
//* 2. COMPARE TOTAL RECORD COUNT BEFORE AND AFTER SORT               *
//* 3. KEEP OUTPUT FILE ONLY IF COUNTS MATCH (COND=(0,NE,STEPCOMP))   *
//* 4. PRINT ERROR MESSAGE ONLY IF COUNTS MISMATCH (COND=(0,EQ))      *
//*===================================================================*
//* STEP 1: SORT IN DESCENDING ORDER USING IBM SORT
//STEP01   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=STUDENT.AUDIT.REXX,DISP=SHR
//SORTOUT  DD DSN=&&SORTDESC,
//            DISP=(NEW,PASS),
//            SPACE=(CYL,(1,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD *
  SORT FIELDS=(1,80,CH,D)
/*
//* STEP 2: VERIFY RECORD COUNTS BEFORE AND AFTER SORT
//STEPCOMP EXEC PGM=IKJEFT01
//SYSPRINT DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSEXEC  DD DSN=STUDENT.EXEC,DISP=SHR
//DS1      DD DSN=STUDENT.AUDIT.REXX,DISP=SHR
//DS2      DD DSN=&&SORTDESC,DISP=SHR
//SYSTSIN  DD *
  EXEC 'STUDENT.EXEC(AUDCOUNT)'
/*
//* STEP 3: SUCCESS PATH — KEEP OUTPUT DATASET ONLY IF COUNTS MATCH (RC=0)
//STEPKEEP EXEC PGM=IEBGENER,COND=(0,NE,STEPCOMP)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=&&SORTDESC,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=STUDENT.AUDIT.FINAL.SUCCESS,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(1,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DUMMY
/*
//* STEP 4: FAILURE PATH — EMIT ERROR ONLY IF COUNTS DO NOT MATCH (RC!=0)
//STEPERR  EXEC PGM=IKJEFT01,COND=(0,EQ,STEPCOMP)
//SYSPRINT DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  WRITE *** CRITICAL ERROR: INTEGRITY CHECK FAILED - COUNTS DO NOT MATCH ***
  WRITE *** OUTPUT DATASET HAS BEEN DISCARDED PER AUDIT POLICY ***
/*
