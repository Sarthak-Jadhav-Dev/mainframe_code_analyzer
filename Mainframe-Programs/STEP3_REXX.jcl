//AUDRX01  JOB (ACCT),'STEP3-REXX',CLASS=A,MSGCLASS=X
//*===================================================================*
//* REQUIREMENT 3: REXX DEDUPLICATION & PRIMARY-KEY SORT              *
//* READS COBOL OUTPUT (STUDENT.AUDIT.COBOL), REMOVES DUPLICATES      *
//* BY CONTENT_HASH, SORTS REMAINING RECORDS, TAGS CATEGORIES,        *
//* AND WRITES DEDUPLICATED REPORT TO (STUDENT.AUDIT.REXX)            *
//*===================================================================*
//STEP01   EXEC PGM=IKJEFT01
//SYSPRINT DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSEXEC  DD DSN=STUDENT.EXEC,DISP=SHR
//AUDRPT   DD DSN=STUDENT.AUDIT.COBOL,DISP=SHR
//AUDOUT   DD DSN=STUDENT.AUDIT.REXX,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(1,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSTSIN  DD *
  EXEC 'STUDENT.EXEC(AUDRXXX)'
/*
