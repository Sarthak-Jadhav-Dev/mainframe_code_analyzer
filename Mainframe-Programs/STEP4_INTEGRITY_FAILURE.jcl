//AUDINT02 JOB (ACCT),'REQ4-FAILURE',CLASS=A,MSGCLASS=X
//*===================================================================*
//* REQUIREMENT 4 — FAILURE TEST CASE (DEMONSTRATES ERROR LOGIC)      *
//* 1. IBM SORT: INTENTIONALLY OMITS A RECORD TO INDUCE COUNT MISMATCH*
//* 2. COMPARE TOTAL RECORD COUNT BEFORE AND AFTER SORT               *
//* 3. STEPKEEP IS AUTOMATICALLY BYPASSED DUE TO COND CODE 12         *
//* 4. STEPERR EXECUTES AND PRINTS ERROR MESSAGE                      *
//*===================================================================*
//* STEP 1: SORT IN DESCENDING ORDER WITH OMIT TO SIMULATE DATA LOSS
//STEP01   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=STUDENT.AUDIT.REXX,DISP=SHR
//SORTOUT  DD DSN=&&SORTDESC,
//            DISP=(NEW,PASS),
//            SPACE=(CYL,(1,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD *
  SORT FIELDS=(1,80,CH,D)
  OMIT COND=(1,3,CH,EQ,C'===')
/*
//* STEP 2: VERIFY RECORD COUNTS (DETECTS THE MISSING RECORD -> RC=12)
//STEPCOMP EXEC PGM=IKJEFT01
//SYSPRINT DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSEXEC  DD DSN=STUDENT.EXEC,DISP=SHR
//DS1      DD DSN=STUDENT.AUDIT.REXX,DISP=SHR
//DS2      DD DSN=&&SORTDESC,DISP=SHR
//SYSTSIN  DD *
  EXEC 'STUDENT.EXEC(AUDCOUNT)'
/*
//* STEP 3: SUCCESS PATH — BYPASSED BECAUSE RC IS NOT 0 (COND=(0,NE))
//STEPKEEP EXEC PGM=IEBGENER,COND=(0,NE,STEPCOMP)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=&&SORTDESC,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=STUDENT.AUDIT.FINAL.FAILCASE,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(1,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DUMMY
/*
//* STEP 4: FAILURE PATH — EXECUTES BECAUSE RC=12 (COND=(0,EQ))
//STEPERR  EXEC PGM=IKJEFT01,COND=(0,EQ,STEPCOMP)
//SYSPRINT DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  WRITE ================================================================
  WRITE *** AUDIT ALERT: REQUIREMENT 4 INTEGRITY VIOLATION DETECTED ***
  WRITE *** RECORD COUNTS DO NOT MATCH BEFORE AND AFTER DESCENDING SORT *
  WRITE *** OUTPUT FILE DISCARDED. DATA CORRUPTION PREVENTED.          *
  WRITE ================================================================
/*
