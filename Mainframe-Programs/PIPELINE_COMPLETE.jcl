//AUDPIPE1 JOB (ACCT),'AUDIT-PIPELINE',CLASS=A,MSGCLASS=X
//*===================================================================*
//* MAINFRAME CODEBASE AUDITOR — COMPLETE 4-REQUIREMENT PIPELINE      *
//*                                                                   *
//* STEP01: JCL SORT FLAT FILE BY TECH_NAME (REQ 1)                   *
//* STEP02: COBOL MATCH-MERGE AGAINST TECHREF (REQ 2)                 *
//* STEP03: REXX DEDUPLICATION & PRIMARY-KEY SORT (REQ 3)             *
//* STEP04: IBM SORT DESCENDING INTEGRITY CHECK PREP (REQ 4)          *
//* STEP05: RECORD COUNT COMPARISON AUDCOUNT (REQ 4)                  *
//* STEP06: CONDITIONAL KEEP FINAL OUTPUT ONLY IF RC=0 (REQ 4)        *
//* STEP07: CONDITIONAL ERROR LOGGING ONLY IF RC!=0 (REQ 4)           *
//*===================================================================*
//*
//* STEP 1: JCL SORT BY TECH_NAME (REQUIREMENT 1)
//STEP01   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=STUDENT.AUDIT.INPUT,DISP=SHR
//SORTOUT  DD DSN=&&STEP1OUT,
//            DISP=(NEW,PASS),
//            SPACE=(CYL,(1,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD *
  SORT FIELDS=(41,10,CH,A,1,40,CH,A)
/*
//*
//* STEP 2: COBOL TWO-FILE MATCH-MERGE (REQUIREMENT 2)
//STEP02   EXEC PGM=AUDCOBOL,COND=(0,NE,STEP01)
//STEPLIB  DD DSN=STUDENT.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//AUDREC   DD DSN=&&STEP1OUT,DISP=(OLD,PASS)
//TECHREF  DD DSN=STUDENT.AUDIT.TECHREF,DISP=SHR
//AUDRPT   DD DSN=&&STEP2OUT,
//            DISP=(NEW,PASS),
//            SPACE=(CYL,(1,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSOUT   DD SYSOUT=*
/*
//*
//* STEP 3: REXX DEDUPLICATION & PRIMARY-KEY SORT (REQUIREMENT 3)
//STEP03   EXEC PGM=IKJEFT01,COND=(0,NE,STEP02)
//SYSPRINT DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSEXEC  DD DSN=STUDENT.EXEC,DISP=SHR
//AUDRPT   DD DSN=&&STEP2OUT,DISP=(OLD,PASS)
//AUDOUT   DD DSN=&&STEP3OUT,
//            DISP=(NEW,PASS),
//            SPACE=(CYL,(1,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSTSIN  DD *
  EXEC 'STUDENT.EXEC(AUDRXXX)'
/*
//*
//* STEP 4: IBM SORT IN DESCENDING ORDER (REQUIREMENT 4)
//STEP04   EXEC PGM=SORT,COND=(0,NE,STEP03)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&&STEP3OUT,DISP=SHR
//SORTOUT  DD DSN=&&STEP4OUT,
//            DISP=(NEW,PASS),
//            SPACE=(CYL,(1,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD *
  SORT FIELDS=(1,80,CH,D)
/*
//*
//* STEP 5: COMPARE RECORD COUNTS BEFORE AND AFTER SORT (REQUIREMENT 4)
//STEP05   EXEC PGM=IKJEFT01,COND=(0,NE,STEP04)
//SYSPRINT DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSEXEC  DD DSN=STUDENT.EXEC,DISP=SHR
//DS1      DD DSN=&&STEP3OUT,DISP=(OLD,PASS)
//DS2      DD DSN=&&STEP4OUT,DISP=(OLD,PASS)
//SYSTSIN  DD *
  EXEC 'STUDENT.EXEC(AUDCOUNT)'
/*
//*
//* STEP 6: CONDITIONAL KEEP — ONLY SAVE FINAL DATASET IF COUNTS MATCH
//STEP06   EXEC PGM=IEBGENER,COND=(0,NE,STEP05)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=&&STEP4OUT,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=STUDENT.AUDIT.FINAL.REPORT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(1,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DUMMY
/*
//*
//* STEP 7: CONDITIONAL ERROR — ONLY TRIGGER IF INTEGRITY CHECK FAILED
//STEP07   EXEC PGM=IKJEFT01,COND=(0,EQ,STEP05)
//SYSPRINT DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  WRITE *** CRITICAL PIPELINE ALERT: REQUIREMENT 4 INTEGRITY CHECK FAILED ***
  WRITE *** RECORD COUNTS DO NOT MATCH. OUTPUT NOT CATALOGED.             ***
/*
